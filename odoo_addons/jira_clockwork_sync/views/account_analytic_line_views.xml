<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista própria (não herdada) dos apontamentos importados:
         evita dependência de XML IDs de views de timesheet que variam
         entre versões do Odoo. -->
    <record id="view_jira_timesheet_tree" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.jira.integration</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-muted="x_integration_status == 'cancelled_source'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="account_id" optional="show" string="Conta Analítica"/>
                <field name="name"/>
                <field name="unit_amount" widget="timesheet_uom" sum="Total"/>
                <field name="x_jira_issue_key"/>
                <field name="x_external_worklog_id" optional="hide"/>
                <field name="x_integration_status"/>
                <field name="x_last_sync_at" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_jira_timesheet_search" model="ir.ui.view">
        <field name="name">account.analytic.line.search.jira.integration</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_jira_issue_key"/>
                <field name="x_external_worklog_id"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <filter string="Cancelados na origem" name="cancelled"
                        domain="[('x_integration_status', '=', 'cancelled_source')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Funcionário" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Projeto" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Conta Analítica" name="group_account"
                            context="{'group_by': 'account_id'}"/>
                    <filter string="Data" name="group_date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_jira_timesheets" model="ir.actions.act_window">
        <field name="name">Apontamentos Importados</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_jira_timesheet_tree"/>
        <field name="search_view_id" ref="view_jira_timesheet_search"/>
        <field name="domain">[('x_external_worklog_id', '!=', False)]</field>
    </record>
</odoo>
