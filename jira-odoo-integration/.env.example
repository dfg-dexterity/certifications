# ============================================================
# Integração Jira + Clockwork Pro -> Odoo
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ============================================================

# --- Jira Cloud -------------------------------------------------------------
# URL base do site, sem barra final
JIRA_BASE_URL=https://dexterity.atlassian.net
# E-mail da conta de serviço + API token
# (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=integracao@dexterity.com.br
JIRA_API_TOKEN=

# --- Clockwork Pro ----------------------------------------------------------
# Token de API do Clockwork (recurso da versão Pro)
CLOCKWORK_API_TOKEN=
# Endpoint padrão da API; só altere se a Herocoders mudar a URL
CLOCKWORK_BASE_URL=https://api.clockwork.report/v1

# --- Odoo -------------------------------------------------------------------
ODOO_URL=https://odoo.dexterity.com.br
ODOO_DB=dexterity
# Usuário de serviço dedicado, membro do grupo "Integração Jira / Gestor"
ODOO_USERNAME=integracao-jira@dexterity.com.br
# Senha ou API key do usuário (preferir API key)
ODOO_PASSWORD=
# Layout do banco no Odoo:
#   addon  = Odoo.sh/on-premise com o addon jira_clockwork_sync instalado
#   studio = Odoo ONLINE com modelos criados via Studio/campos customizados
#            (ver docs/odoo-online-studio.md)
ODOO_SCHEMA=addon

# --- Comportamento da sincronização ----------------------------------------
# Janela deslizante do comando "sync": processa de (hoje - N dias) até hoje.
# Alterações em worklogs mais antigos que N dias só entram via backfill.
SYNC_LOOKBACK_DAYS=7
# Tamanho dos blocos de consulta ao Clockwork, em dias
CLOCKWORK_CHUNK_DAYS=7
# "true" para gravar também linhas de sucesso no log do Odoo (mais volume)
SYNC_LOG_SUCCESS=false
# "true" permite mover tarefa de projeto quando a regra de alocação mudar
SYNC_ALLOW_TASK_PROJECT_UPDATE=false
# "true" simula sem gravar nada no Odoo
SYNC_DRY_RUN=false
